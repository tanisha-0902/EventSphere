<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="/css/style.css" rel="stylesheet">
    <style>
        /* Light Gradient Background */
        body {
            background: linear-gradient(135deg, #f9f9f9 0%, #eaeaea 100%);
            color: #212529;
            font-family: 'Poppins', sans-serif;
            min-height: 100vh;
            position: relative;
        }

        /* Glass Cards */
        .glass {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(0, 0, 0, 0.05);
            border-radius: 20px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

        /* Page Header */
        .page-header {
            background: linear-gradient(135deg, #e0e0e0, #ffffff);
            color: #212529;
            text-align: center;
            padding: 5rem 0;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
        }

        .page-header h1 {
            font-weight: 700;
            font-size: 3rem;
            color: #001F54;
        }

        .page-header p {
            color: #333;
        }

        /* Event Cards */
        .event-card {
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .event-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
        }

        .event-card img {
            border-top-left-radius: 20px;
            border-top-right-radius: 20px;
            height: 220px;
            object-fit: cover;
        }

        .event-date {
            background: linear-gradient(135deg, #001F54, #003566);
            color: white;
            font-weight: 600;
            font-size: 0.9rem;
            display: inline-block;
            padding: 0.5rem 1rem;
            border-radius: 8px;
            margin-bottom: 1rem;
        }

        /* Buttons Gradient */
        .btn-primary {
            background: linear-gradient(135deg, #001F54, #003566);
            border: none;
            transition: all 0.3s ease;
        }

        .btn-primary:hover {
            background: linear-gradient(135deg, #003566, #001F54);
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.15);
        }

        .btn-outline-primary {
            color: #001F54;
            border: 1px solid #001F54;
        }

        .btn-outline-primary.active,
        .btn-outline-primary:hover {
            background: #001F54;
            color: #fff;
        }

        /* CTA Section */
        .cta-section {
            background: linear-gradient(135deg, #f0f0f0, #e0e0e0);
            padding: 4rem 0;
            text-align: center;
            border-top: 1px solid rgba(0, 0, 0, 0.05);
        }

        /* Fade Animation */
        .fade-in {
            opacity: 0;
            transform: translateY(20px);
            transition: all 0.6s ease;
        }

        .fade-in.show {
            opacity: 1;
            transform: translateY(0);
        }

        /* Spacing between sections */
        section+section {
            margin-top: 3rem;
        }

        /* User Auth Status Bar - Enhanced Styling */
        .auth-status-bar {
            background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 100%);
            padding: 1.5rem 0;
            box-shadow: 0 4px 15px rgba(15, 23, 42, 0.4);
            position: relative;
            overflow: hidden;
        }

        .auth-status-bar::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(90deg, 
                rgba(255,255,255,0.08) 0%, 
                rgba(255,255,255,0.03) 50%, 
                rgba(255,255,255,0.08) 100%);
            pointer-events: none;
        }

        .auth-content {
            position: relative;
            z-index: 1;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 1.5rem;
        }

        .auth-status-text {
            color: #ffffff;
            font-weight: 500;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .auth-status-text .user-icon {
            width: 36px;
            height: 36px;
            background: rgba(255, 255, 255, 0.15);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            backdrop-filter: blur(10px);
            color: #ffffff;
        }

        .auth-status-text .user-name {
            font-weight: 700;
            font-size: 1rem;
            color: #ffffff;
        }

        .auth-buttons {
            display: flex;
            gap: 0.75rem;
        }

        .auth-btn {
            padding: 0.6rem 1.2rem;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            transition: all 0.3s ease;
            border: none;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .auth-btn-login {
            background: rgba(255, 255, 255, 0.12);
            color: #ffffff;
            border: 1.5px solid rgba(255, 255, 255, 0.25);
        }

        .auth-btn-login:hover {
            background: rgba(255, 255, 255, 0.22);
            border-color: rgba(255, 255, 255, 0.45);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
        }

        .auth-btn-register {
            background: #ffffff;
            color: #1e3a5f;
            border: none;
            font-weight: 700;
        }

        .auth-btn-register:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(255, 255, 255, 0.4);
            background: #f0f4f8;
        }

        .auth-btn-logout {
            background: rgba(255, 255, 255, 0.12);
            color: #ffffff;
            border: 1.5px solid rgba(255, 255, 255, 0.25);
        }

        .auth-btn-logout:hover {
            background: rgba(255, 255, 255, 0.22);
            border-color: rgba(255, 255, 255, 0.45);
            transform: translateY(-2px);
            color: #ffffff;
        }

        @media (max-width: 768px) {
            .auth-content {
                flex-direction: column;
                gap: 1rem;
            }

            .auth-buttons {
                width: 100%;
                justify-content: center;
            }
        }
    </style>
</head>

<body>
    <%- include('partials/navbar') %>

        <main>
            <%- include('partials/flash-messages') %>

                <!-- User Auth Status Bar - Enhanced -->
                <section class="auth-status-bar">
                    <div class="container">
                        <div class="auth-content">
                            <div class="auth-status-text">
                                <% if (session && session.userId) { %>
                                    <div class="user-icon">
                                        <i class="fas fa-user"></i>
                                    </div>
                                    <div>
                                        Welcome back, <span class="user-name"><%= session.userName %></span>
                                    </div>
                                <% } else { %>
                                    <div class="user-icon">
                                        <i class="fas fa-lock-open"></i>
                                    </div>
                                    <div>
                                        Sign in to register for events
                                    </div>
                                <% } %>
                            </div>
                            <div class="auth-buttons">
                                <% if (session && session.userId) { %>
                                    <a href="/user/logout" class="auth-btn auth-btn-logout">
                                        <i class="fas fa-sign-out-alt"></i>
                                        <span>Logout</span>
                                    </a>
                                <% } else { %>
                                    <a href="/user/login" class="auth-btn auth-btn-login">
                                        <i class="fas fa-sign-in-alt"></i>
                                        <span>Login</span>
                                    </a>
                                    <a href="/user/register" class="auth-btn auth-btn-register">
                                        <i class="fas fa-user-plus"></i>
                                        <span>Register</span>
                                    </a>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Hero / Page Header -->
                <section class="page-header fade-in show" style="
            background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), 
                        url('https://images.unsplash.com/photo-1470229722913-7c0e2dbbafd3?fm=jpg&ixid=M3wxMjA3fDB8MHxwaG90by1yZWxhdGVkfDE0fHx8ZW58MHx8fHx8&ixlib=rb-4.1.0&q=80&w=1920') no-repeat center center;
            background-size: cover;
            color: #fff;
            text-align: center;
            padding: 5rem 0;
        ">
                    <h1 style="color: white;">Upcoming Events</h1>
                    <p class="lead" style="color: white;">Discover amazing experiences happening around you.</p>
                </section>

                <!-- Events Section -->
                <section class="container py-5 fade-in">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h3><i class="fas fa-calendar-alt text-primary me-2"></i>All Events (<%= events.length %>)</h3>
                        <div class="btn-group">
                            <button class="btn btn-outline-primary active" data-filter="all">
                                <i class="fas fa-th me-1"></i>All
                            </button>
                            <button class="btn btn-outline-primary" data-filter="upcoming">
                                <i class="fas fa-clock me-1"></i>Upcoming
                            </button>
                        </div>
                    </div>

                    <div class="row g-4" id="events-list-container">
                        <% if (events && events.length> 0) { %>
                            <% events.forEach(event=> { %>
                                <div class="col-lg-4 col-md-6 event-item" data-date="<%= event.date %>">
                                    <div class="card glass event-card h-100">
                                        <img src="<%= event.image %>" alt="<%= event.title %>">
                                        <div class="card-body d-flex flex-column">
                                            <h5 class="card-title mb-3">
                                                <%= event.title %>
                                            </h5>
                                            <p class="event-date">
                                                <i class="fas fa-calendar-alt me-2"></i>
                                                <%= new Date(event.date).toLocaleDateString('en-US', { month: 'short' ,
                                                    day: 'numeric' , year: 'numeric' }) %>
                                            </p>
                                            <p class="text-dark flex-grow-1">
                                                <%= event.description %>
                                            </p>
                                            <div class="mt-auto d-flex justify-content-between align-items-center">
                                                <small class="text-muted">
                                                    <%= new Date(event.date)> new Date() ? 'Upcoming' : 'Past Event' %>
                                                </small>
                                                <div class="d-flex gap-2">
                                                    <a href="/events/<%= event._id.toString() %>" class="btn btn-primary btn-sm">
                                                        <i class="fas fa-info-circle me-1"></i>Details
                                                    </a>

                                                    <!-- User registration button -->
                                                    <button class="btn btn-outline-success btn-sm register-btn"
                                                            data-event-id="<%= event._id.toString() %>"
                                                            data-event-date="<%= event.date %>">
                                                        Register
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <% }) %>
                                    <% } else { %>
                                        <div class="text-center py-5">
                                            <i class="fas fa-calendar-times fa-3x text-muted mb-3"></i>
                                            <h4>No Events Available</h4>
                                            <p>There are currently no events scheduled. Check back soon!</p>
                                        </div>
                                        <% } %>
                    </div>
                </section>

                <!-- CTA Section -->
                <section class="cta-section fade-in show">
                    <h2 class="fw-bold mb-3">Want to Host Your Own Event?</h2>
                    <p class="lead mb-4">Join thousands of organizers who trust Event Sphere.</p>
                    <a href="/contact" class="btn btn-primary btn-lg">
                        <i class="fas fa-plus-circle me-2"></i>Get Started
                    </a>
                </section>
        </main>

        <%- include('partials/footer') %>

            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
            <script>
                // Fade-in animation
                document.addEventListener("DOMContentLoaded", () => {
                    const fadeEls = document.querySelectorAll('.fade-in');
                    fadeEls.forEach((el, index) => {
                        setTimeout(() => el.classList.add('show'), 200 * index);
                    });
                });

                // Filter logic
                const filterButtons = document.querySelectorAll('[data-filter]');
                // 🌟 CHANGE 3: Use 'let' so the list can be updated when a new event arrives 🌟
                let eventItems = document.querySelectorAll('.event-item');

                filterButtons.forEach(button => {
                    button.addEventListener('click', () => {
                        filterButtons.forEach(btn => btn.classList.remove('active'));
                        button.classList.add('active');
                        const filter = button.getAttribute('data-filter');
                        const now = new Date();
                        eventItems.forEach(item => {
                            const eventDate = new Date(item.dataset.date);
                            if (filter === 'upcoming' && eventDate < now) {
                                item.style.display = 'none';
                            } else {
                                item.style.display = 'block';
                            }
                        });
                    });
                });

                // Debug: Log event IDs when page loads
                console.log('Events on page:');
                document.querySelectorAll('.btn-primary').forEach(btn => {
                    console.log('Event link:', btn.href);
                });
            </script>
            <script>
                // Registered events passed from server
                let registeredEventIds = <%- JSON.stringify(registeredEventIds || []) %>;

                function updateRegisterButtonState(btn, isRegistered) {
                    if (!btn) return;
                    if (isRegistered === 'past') {
                        btn.textContent = 'Closed';
                        btn.classList.remove('btn-outline-success', 'btn-success', 'btn-outline-danger');
                        btn.classList.add('btn-secondary');
                        btn.disabled = true;
                        return;
                    }

                    if (isRegistered) {
                        btn.textContent = 'Unregister';
                        btn.classList.remove('btn-outline-success', 'btn-success', 'btn-secondary');
                        btn.classList.add('btn-outline-danger');
                        btn.disabled = false;
                    } else {
                        btn.textContent = 'Register';
                        btn.classList.remove('btn-success', 'btn-secondary', 'btn-outline-danger');
                        btn.classList.add('btn-outline-success');
                        btn.disabled = false;
                    }
                }

                function setupRegisterButtons() {
                    document.querySelectorAll('.register-btn').forEach(btn => {
                        const eventId = btn.dataset.eventId;
                        const dateStr = btn.dataset.eventDate || btn.closest('.event-item')?.dataset.date;
                        const eventDate = dateStr ? new Date(dateStr) : null;
                        const isPast = eventDate ? (eventDate <= new Date()) : false;

                        if (isPast) {
                            updateRegisterButtonState(btn, 'past');
                            return;
                        }

                        updateRegisterButtonState(btn, registeredEventIds.includes(eventId));

                        btn.onclick = async (e) => {
                            e.preventDefault();
                            if (btn.disabled) return;
                            
                            const isRegistered = registeredEventIds.includes(eventId);
                            const actionUrl = isRegistered ? `/events/${eventId}/unregister` : `/events/${eventId}/register`;
                            
                            console.log(`Button clicked for ${eventId}, action: ${isRegistered ? 'unregister' : 'register'}`);
                            
                            try {
                                const resp = await fetch(actionUrl, {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    credentials: 'same-origin'
                                });

                                if (resp.status === 401) {
                                    window.location.href = '/user/login';
                                    return;
                                }

                                const data = await resp.json();
                                console.log('Response data:', data);

                                if (resp.ok && data && data.success) {
                                    if (isRegistered) {
                                        registeredEventIds = registeredEventIds.filter(id => id !== eventId);
                                    } else {
                                        if (!registeredEventIds.includes(eventId)) registeredEventIds.push(eventId);
                                    }
                                    updateRegisterButtonState(btn, !isRegistered);
                                } else {
                                    alert(data.message || 'Action failed.');
                                }
                            } catch (err) {
                                console.error('Request failed:', err);
                                alert('Action failed. Try again later.');
                            }
                        };
                    });
                }

                document.addEventListener('DOMContentLoaded', () => setupRegisterButtons());
                </script>
            <script src="/socket.io/socket.io.js"></script>
            <script>
                // Use the main server URL (adjust if needed, but 3000 is default)
                const WS_URL = 'http://localhost:3000';
                const socket = io(WS_URL);

                socket.on('connect', () => {
                    console.log('🔗 WebSocket client connected and ready for real-time event updates.');
                });

                // This listener is triggered by the 'io.emit("events:updated", ...)' in server.js
                socket.on('events:updated', (data) => {
                    if (data.action === 'created' && data.event) {
                        handleNewEvent(data.event);
                    }
                });
               // Function to dynamically insert the new event card
function handleNewEvent(newEvent) {
    console.log(`📢 Real-Time Update: Dynamically adding event: ${newEvent.title}`);

    // Target the container element
    const eventContainer = document.getElementById('events-list-container');
    if (!eventContainer) return;

    // --- HTML CARD GENERATION ---
    const eventDateStr = new Date(newEvent.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    const isUpcoming = new Date(newEvent.date) > new Date();
    const statusText = isUpcoming ? 'Upcoming' : 'Past Event';
    const eventId = newEvent._id ? newEvent._id.toString() : 'new-event-temp';


        // Build DOM nodes instead of string templates to avoid template-literal parsing issues
        const col = document.createElement('div');
        col.className = 'col-lg-4 col-md-6 event-item new-event';
        col.dataset.date = newEvent.date;

        const card = document.createElement('div');
        card.className = 'card glass event-card h-100';
        card.id = `event-${eventId}`;

        const img = document.createElement('img');
        img.src = newEvent.image || 'https://via.placeholder.com/300x220?text=Event+Image';
        img.alt = newEvent.title || '';

        const body = document.createElement('div');
        body.className = 'card-body d-flex flex-column';

        const h5 = document.createElement('h5');
        h5.className = 'card-title mb-3';
        h5.textContent = newEvent.title || 'Untitled Event';

        const pDate = document.createElement('p');
        pDate.className = 'event-date';
        pDate.innerHTML = '<i class="fas fa-calendar-alt me-2"></i>' + eventDateStr;

        const pDesc = document.createElement('p');
        pDesc.className = 'text-dark flex-grow-1';
        pDesc.textContent = newEvent.description || 'No description provided.';

        const footer = document.createElement('div');
        footer.className = 'mt-auto d-flex justify-content-between align-items-center';

        const small = document.createElement('small');
        small.className = 'text-muted';
        small.textContent = statusText;

        const detailWrapper = document.createElement('div');
        detailWrapper.className = 'd-flex gap-2';

        const detailLink = document.createElement('a');
        detailLink.className = 'btn btn-primary btn-sm';
        detailLink.href = `/events/${eventId}`;
        detailLink.innerHTML = '<i class="fas fa-info-circle me-1"></i>Details';

        const regBtn = document.createElement('button');
        regBtn.className = 'btn btn-outline-success btn-sm register-btn';
        regBtn.dataset.eventId = eventId;
        regBtn.dataset.eventDate = newEvent.date;
        regBtn.textContent = 'Register';

        detailWrapper.appendChild(detailLink);
        detailWrapper.appendChild(regBtn);

        footer.appendChild(small);
        footer.appendChild(detailWrapper);

        body.appendChild(h5);
        body.appendChild(pDate);
        body.appendChild(pDesc);
        body.appendChild(footer);

        card.appendChild(img);
        card.appendChild(body);
        col.appendChild(card);

        // 1. Insert the new event card at the beginning of the grid
        eventContainer.insertAdjacentElement('afterbegin', col);

        // 2. Update the filterable list reference (for the filter button logic)
        eventItems = document.querySelectorAll('.event-item');

        // 3. The inserted element is 'col'
        const insertedElement = col;

    if (insertedElement) {
        setTimeout(() => {
            insertedElement.classList.add('fade-in-flash');
            insertedElement.classList.remove('new-event');
            setTimeout(() => insertedElement.classList.remove('fade-in-flash'), 1500);
        }, 50);
    }

    // Re-attach register button handlers for the newly inserted element
    setupRegisterButtons();
}
            </script>
</body>

</html>